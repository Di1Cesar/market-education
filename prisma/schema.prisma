// Mercadinho da Turma — schema compartilhado
// Regra de ouro: dinheiro sempre em Int de centavos. Nunca Float.
// 350 = R$ 3,50

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooler, porta 6543
  directUrl = env("DIRECT_URL")   // conexão direta 5432, só para migrations
}

model Product {
  id         String  @id @default(uuid())
  name       String
  emoji      String  @default("📦")
  priceCents Int
  stock      Int     @default(0)
  active     Boolean @default(true)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Sale {
  id          String @id @default(uuid())
  totalCents  Int
  paidCents   Int
  changeCents Int

  items     SaleItem[]
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String?

  // Cópias congeladas: o cupom de hoje não muda se o produto
  // for renomeado ou reprecificado amanhã.
  nameSnapshot   String
  emojiSnapshot  String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
}
