# ---------------------------------------------------------------------------
# Backend NestJS — variáveis do banco (Supabase)
#
# São DUAS URLs, não uma. É o erro nº 1 de quem junta Prisma com Supabase:
#   DATABASE_URL → pooler na porta 6543 (a aplicação usa em produção)
#   DIRECT_URL   → conexão direta na 5432 (o `prisma migrate` usa)
#
# Copie de: Supabase → Project Settings → Database → Connection string
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Porta do backend e origem liberada no CORS (o front roda em :3000)
PORT=3001
WEB_ORIGIN="http://localhost:3000"
